# Copia este archivo como .env.local para desarrollo local
# En Vercel, agrega estas variables en Settings > Environment Variables

SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
API_SECRET_TOKEN=un_token_largo_y_aleatorio_para_proteger_la_api

# REACT_APP_API_URL se deja vacío en producción (Vercel sirve /api desde el mismo dominio)
# Solo se necesita en desarrollo local si corres el backend por separado
# REACT_APP_API_URL=http://localhost:3001
REACT_APP_API_SECRET_TOKEN=el_mismo_valor_de_API_SECRET_TOKEN
